# Local prototype: bind API to 127.0.0.1. Never put credentials in frontend/VITE variables.
ANI_DATA_DIR=../data
ANI_PORT=8000
# Optional: enables writes using X-Admin-Key when deploying beyond localhost.
ANI_ADMIN_KEY=
# 0 disables scheduling; 24 refreshes previously collected areas daily.
ANI_REFRESH_HOURS=0
# Optional paid Open-Meteo subscription for commercial use / higher quotas.
OPEN_METEO_API_KEY=
# Optional custom CA bundle for institutional proxies. TLS verification stays enabled.
ANI_CA_BUNDLE=
